<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Turns the Showroom chapters into the site's Examples section.

	  It only ever *parses* C#; it never restores or builds the Showroom. That is deliberate: the
	  Showroom pins published package versions, so building it depends on the release chain, while
	  documenting it should not.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<RootNamespace>ShowroomDocs</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
	</ItemGroup>

</Project>
